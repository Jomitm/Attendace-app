// Firestore Security Rules — CRWI Attendance App
// Requires Firebase Authentication. All requests must be authenticated.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('employmentStatus', 'active') in ['former', 'resigned', 'retired', 'inactive']) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') != 'inactive';
    }

    function isAdmin() {
      return isAuthenticated() && currentStaff().get('isAdmin', false) == true;
    }

    function isHR() {
      return isAuthenticated() && currentStaff().get('role', '') in ['hr', 'Administrator'];
    }

    function isOwner() {
      return isAdmin();
    }

    function isStaff() {
      return isAuthenticated() && currentStaff().get('role', '') == 'Employee';
    }

    function isReportsAdmin() {
      return isAdmin() || (isAuthenticated() &&
        currentStaff().get('permissions', {}).get('reports', '') == 'admin');
    }

    function currentStaff() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Current profile permissions are authoritative. Stale token claims and
    // user_access mirrors must not restore a removed grant.
    function hasBirthdayAdminPermission() {
      return isAuthenticated() && (
        currentStaff().get('permissions', {}).get('birthday', '') == 'admin' ||
        currentStaff().get('permissions', {}).get('users', '') == 'admin' ||
        currentStaff().get('canManageBirthdays', false) == true
      );
    }

    function isBirthdayAdmin() {
      return isHR() || isAdmin() || hasBirthdayAdminPermission();
    }


    function canReadStaffHistory() {
      return isAdmin() || (isAuthenticated() && currentStaff().get('permissions', {}).get('users', '') == 'admin');
    }
    function moduleAdmin(module) {
      return isAdmin() || (isAuthenticated() && currentStaff().get('permissions', {}).get(module, '') == 'admin');
    }
    function attendanceManager() {
      return isHR() || moduleAdmin('attendance') || (isAuthenticated() && currentStaff().get('canManageAttendanceSheet', false) == true);
    }
    function activeStaffId(uid) {
      return uid is string && uid.size() > 0 && exists(/databases/$(database)/documents/users/$(uid)) &&
        !(get(/databases/$(database)/documents/users/$(uid)).data.get('employmentStatus', 'active') in ['former', 'resigned', 'retired', 'inactive']) &&
        get(/databases/$(database)/documents/users/$(uid)).data.get('status', '') != 'inactive';
    }
    function recordOwner(data) {
      return data.get('user_id', data.get('userId', data.get('staffId', data.get('ownerId', data.get('createdById', data.get('createdBy', ''))))));
    }
    function activeOwner(data) {
      return recordOwner(data) == 'annual_shared' ? activeStaffId(data.get('createdById', '')) : activeStaffId(recordOwner(data));
    }
    function ownRecord(data) {
      return isAuthenticated() && recordOwner(data) == request.auth.uid;
    }
    function validOwnedRecord(data) {
      return data.get('user_id', data.get('userId', '')) == data.get('userId', data.get('user_id', '')) &&
        recordOwner(data) is string && recordOwner(data).size() > 0 && recordOwner(data).size() <= 128 &&
        (data.get('date', '') is string && data.get('date', '').size() <= 32) &&
        (data.get('title', '') is string && data.get('title', '').size() <= 1000);
    }
    function validPrivateParent(data) {
      let parent = getAfter(/databases/$(database)/documents/work_plans/$(data.planId)).data;
      return (parent.get('userId', '') == 'annual_shared' ? parent.get('createdById', '') : parent.get('userId', '')) == data.ownerId;
    }
    function validSharedSummary(data) {
      return data.get('dateKey', '') is string && data.get('dateKey', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.get('version', 0) is int && data.get('version', 0) > 0 && data.get('generatedAt', 0) is int && data.get('generatedAt', 0) > 0;
    }
    function validMessage(data) {
      return data.get('fromId', '') is string && data.get('toId', '') is string &&
        data.get('fromId', '').size() > 0 && data.get('toId', '').size() > 0 &&
        data.get('message', '') is string && data.get('message', '').size() <= 20000 &&
        data.get('title', '') is string && data.get('title', '').size() <= 1000 &&
        data.get('description', '') is string && data.get('description', '').size() <= 20000 &&
        data.get('history', []) is list && data.get('history', []).size() <= 1000;
    }
    function validMinutes(data) {
      return data.get('createdBy', '') is string && data.get('createdBy', '').size() > 0 &&
        data.get('title', '') is string && data.get('title', '').size() <= 1000 &&
        data.get('actionItems', []) is list && data.get('actionItems', []).size() <= 1000 &&
        data.get('attendeeIds', []) is list && data.get('attendeeIds', []).size() <= 300 &&
        data.get('approvals', {}) is map && data.get('locked', false) is bool;
    }

    match /staff_directory_state/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /daily_standups/{docId} {
      allow read: if canReadStaffHistory() || ownRecord(resource.data);
      allow create: if ownRecord(request.resource.data) && validOwnedRecord(request.resource.data);
      allow update: if ownRecord(resource.data) && validOwnedRecord(request.resource.data) && recordOwner(request.resource.data) == recordOwner(resource.data);
      allow delete: if isAdmin();
    }

    // ── Users ──────────────────────────────────────────────────
    // Legacy profiles without employment fields remain active. Only administrators
    // can change these fields; staff cannot undo their own deactivation.
    function isValidEmploymentState(data) {
      return data.get('employmentStatus', 'active') in ['active', 'former', 'resigned', 'retired', 'inactive'] &&
        (data.get('employmentEndedAt', null) == null ||
          (data.employmentEndedAt is string && data.employmentEndedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
    }

    function isValidStaffProfile(data) {
      return isValidEmploymentState(data) &&
        (data.get('name', '') is string && data.get('name', '').size() <= 200) &&
        (data.get('username', '') is string && data.get('username', '').size() <= 100) &&
        (data.get('role', '') is string && data.get('role', '').size() <= 100) &&
        data.get('isAdmin', false) is bool &&
        data.get('permissions', {}) is map;
    }

    function serverAccountFieldsUnchanged() {
      return resource.data.get('status', '') != 'inactive' &&
        request.resource.data.get('status', '') != 'inactive' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'employmentStatus', 'employmentEndedAt', 'employmentChangedAt',
        'password', 'authMigrated', 'passwordSetupRequired'
      ]);
    }
    match /users/{userId} {
      // Any authenticated user can read (needed for staff directory, team views)
      allow get: if isAuthenticated() && (request.auth.uid == userId || canReadStaffHistory());
      allow list: if canReadStaffHistory();
      // Users can update their own non-privileged profile fields; admins can update anyone.
      allow create: if isAdmin() && isValidStaffProfile(request.resource.data) &&
        request.resource.data.get('employmentStatus', 'active') == 'active' &&
        request.resource.data.get('status', 'out') != 'inactive' &&
        request.resource.data.get('employmentEndedAt', null) == null &&
        !request.resource.data.keys().hasAny(['employmentChangedAt', 'password', 'authMigrated']) &&
        request.resource.data.get('id', userId) == userId;
      allow update: if isValidStaffProfile(request.resource.data) && serverAccountFieldsUnchanged() &&
        (request.resource.data.get('id', userId) == userId ||
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['id']) && resource.data.get('id', userId) != userId)) && (isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'permissions', 'canManageAttendanceSheet', 'canManageBirthdays',
          'canCustomizeDashboard', 'password', 'passwordSetupRequired', 'authMigrated',
          'employmentStatus', 'employmentEndedAt', 'employmentChangedAt',
          'baseSalary', 'otherAllowances', 'providentFund', 'professionalTax', 'loanAdvance',
          'tdsPercent', 'bankName', 'bankAccount', 'bankIfsc', 'accountNumber', 'ifsc',
          'pan', 'PAN', 'uan', 'UAN'
        ])
      ));
      allow delete: if isAdmin();
    }

    // Authorization mirror used by Firestore rules for promptly revocable permissions.
    match /user_access/{userId} {
      allow read, write: if isAdmin();
    }

    // Employment notes are separate from the publicly readable staff profile.
    // All writes are made through the authenticated employment endpoint.
    match /staff_employment/{userId} {
      allow read: if isAdmin() || (isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('permissions', {}).get('users', '') == 'admin');
      allow write: if false;
    }

    // ── Attendance ─────────────────────────────────────────────
    match /attendance/{docId} {
      allow read: if canReadStaffHistory() || (ownRecord(resource.data) && activeOwner(resource.data));
      allow create: if isAuthenticated() && validOwnedRecord(request.resource.data) && (isAdmin() || activeOwner(request.resource.data)) && (ownRecord(request.resource.data) || attendanceManager());
      allow update: if isAuthenticated() && validOwnedRecord(request.resource.data) && recordOwner(request.resource.data) == recordOwner(resource.data) && (isAdmin() || activeOwner(resource.data)) && (ownRecord(resource.data) || attendanceManager());
      allow delete: if isAdmin();
    }

    // ── Leaves ─────────────────────────────────────────────────
    match /leaves/{docId} {
      allow read: if canReadStaffHistory() || (ownRecord(resource.data) && activeOwner(resource.data));
      allow create: if ownRecord(request.resource.data) && validOwnedRecord(request.resource.data) && request.resource.data.status == 'Pending';
      allow update: if isAuthenticated() && validOwnedRecord(request.resource.data) && request.resource.data.userId == resource.data.userId && (isAdmin() || activeOwner(resource.data)) && (
        (ownRecord(resource.data) && resource.data.status == 'Pending' && request.resource.data.status == 'Cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'actionDate', 'actionBy', 'adminComment', 'reviewHistory'])) || isHR() || moduleAdmin('leaves'));
      allow delete: if isAdmin();
    }

    // ── Minutes ────────────────────────────────────────────────
    match /minutes/{docId} {
      allow read: if canReadStaffHistory() || (isAuthenticated() && resource.data.get('createdBy', '') == request.auth.uid && activeStaffId(resource.data.get('createdBy', '')));
      allow create: if isAuthenticated() && validMinutes(request.resource.data) && request.resource.data.createdBy == request.auth.uid && request.resource.data.get('locked', false) == false && request.resource.data.get('approvals', {}).size() == 0;
      allow update: if isAuthenticated() && validMinutes(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy && (isAdmin() || activeStaffId(resource.data.createdBy)) && !resource.data.get('locked', false) && (moduleAdmin('minutes') || resource.data.createdBy == request.auth.uid) && request.resource.data.get('locked', false) == resource.data.get('locked', false) && request.resource.data.get('approvals', {}) == resource.data.get('approvals', {});
      allow delete: if isAuthenticated() && (isAdmin() || activeStaffId(resource.data.createdBy)) && (moduleAdmin('minutes') || resource.data.createdBy == request.auth.uid);
    }

    // ── Staff Messages ────────────────────────────────────────
    match /staff_messages/{docId} {
      allow read: if canReadStaffHistory() || (isAuthenticated() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid) && activeStaffId(resource.data.fromId) && activeStaffId(resource.data.toId));
      allow create: if isAuthenticated() && validMessage(request.resource.data) && request.resource.data.fromId == request.auth.uid && activeStaffId(request.resource.data.toId);
      allow update: if isAuthenticated() && validMessage(request.resource.data) && request.resource.data.fromId == resource.data.fromId && request.resource.data.toId == resource.data.toId && (isAdmin() || (activeStaffId(resource.data.fromId) && activeStaffId(resource.data.toId) && (
        (resource.data.fromId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'read', 'respondedAt', 'rejectReason', 'calendarSynced', 'history'])) ||
        (resource.data.toId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'status', 'respondedAt', 'rejectReason', 'calendarSynced', 'history']) && (
          request.resource.data.get('history', []) == resource.data.get('history', []) ||
          (request.resource.data.get('history', []).size() == resource.data.get('history', []).size() + 1 && request.resource.data.history[0].byId == request.auth.uid && request.resource.data.history.removeAll([request.resource.data.history[0]]) == resource.data.get('history', []))
        ))
      )));
      allow delete: if isAdmin();
    }

    // ── Location Audits ───────────────────────────────────────
    match /location_audits/{docId} {
      allow read: if canReadStaffHistory() || ownRecord(resource.data);
      allow create: if ownRecord(request.resource.data) && validOwnedRecord(request.resource.data);
      allow update: if isAdmin() && validOwnedRecord(request.resource.data) && recordOwner(request.resource.data) == recordOwner(resource.data);
      allow delete: if isAdmin();
    }

    // ── Work Plans ────────────────────────────────────────────
    match /work_plans/{docId} {
      allow read: if canReadStaffHistory() || (isAuthenticated() && activeOwner(resource.data) && (resource.data.get('userId', '') == request.auth.uid || resource.data.get('createdById', '') == request.auth.uid));
      allow create: if isAuthenticated() && validOwnedRecord(request.resource.data) && request.resource.data.get('plans', []) is list && request.resource.data.get('plans', []).size() <= 1000 && (isAdmin() || activeOwner(request.resource.data)) && (
        isHR() || isAdmin() || request.resource.data.get('userId', '') == request.auth.uid || (request.resource.data.get('userId', '') == 'annual_shared' && request.resource.data.get('createdById', '') == request.auth.uid)
      );
      allow update: if isAuthenticated() && validOwnedRecord(request.resource.data) && request.resource.data.get('plans', []) is list && request.resource.data.get('plans', []).size() <= 1000 && (isAdmin() || activeOwner(resource.data)) &&
        request.resource.data.get('userId', '') == resource.data.get('userId', '') && (
          isHR() || isAdmin() ||
          (
            resource.data.get('userId', '') == request.auth.uid &&
            (
              resource.data.get('createdById', '') == '' || resource.data.get('createdById', '') == null
                ? request.resource.data.get('createdById', '') == request.auth.uid
                : request.resource.data.get('createdById', '') == resource.data.get('createdById', '')
            )
          ) ||
          (
            resource.data.get('createdById', '') == request.auth.uid &&
            request.resource.data.get('createdById', '') == resource.data.get('createdById', '')
          )
        );
      allow delete: if isHR() || isAdmin() || resource.data.get('userId', '') == request.auth.uid || resource.data.get('createdById', '') == request.auth.uid;
    }

    // Private task bodies are kept outside shared work-plan documents. The
    // owner controls the record; the assignee may read and update the task,
    // but cannot change its owner, plan, or assignment.
    match /private_work_plan_tasks/{taskId} {
      allow read: if isAuthenticated() && activeStaffId(resource.data.ownerId) &&
        (resource.data.ownerId == request.auth.uid || resource.data.assignedTo == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.createdById == request.auth.uid &&
        (request.resource.data.ownerId == request.auth.uid || isAdmin()) &&
        validPrivateParent(request.resource.data) &&
        request.resource.data.id == taskId &&
        request.resource.data.keys().hasOnly(['id', 'ownerId', 'createdById', 'assignedTo', 'planId', 'taskIndex', 'task']) &&
        request.resource.data.task is map &&
        request.resource.data.planId is string &&
        request.resource.data.taskIndex is int &&
        request.resource.data.createdById is string &&
        request.resource.data.assignedTo is string;
      allow update: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['id', 'ownerId', 'createdById', 'assignedTo', 'planId', 'taskIndex', 'task']) &&
        request.resource.data.id == taskId &&
        request.resource.data.createdById is string &&
        request.resource.data.assignedTo is string &&
        request.resource.data.taskIndex is int &&
        request.resource.data.task is map &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.planId == resource.data.planId &&
        (request.auth.uid == resource.data.ownerId ||
          (request.auth.uid == resource.data.assignedTo &&
            request.resource.data.assignedTo == resource.data.assignedTo));
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    // ── Day Plan ──────────────────────────────────────────────
    match /day_plan/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Meetings ──────────────────────────────────────────────
    match /meetings/{docId} {
      allow read: if canReadStaffHistory() || (isAuthenticated() && resource.data.get('createdById', '') == request.auth.uid && activeOwner(resource.data));
      allow create: if isAuthenticated() && validOwnedRecord(request.resource.data) && request.resource.data.get('createdById', '') == request.auth.uid;
      allow update: if isAuthenticated() && (moduleAdmin('minutes') || resource.data.get('createdById', '') == request.auth.uid) && request.resource.data.get('createdById', '') == resource.data.get('createdById', '') && (isAdmin() || activeOwner(resource.data));
      allow delete: if moduleAdmin('minutes') || (isAuthenticated() && resource.data.get('createdById', '') == request.auth.uid && activeOwner(resource.data));
    }

    // ── Salaries ──────────────────────────────────────────────
    match /salaries/{docId} {
      allow read: if isReportsAdmin() && (canReadStaffHistory() || activeOwner(resource.data));
      allow create: if isReportsAdmin() && validOwnedRecord(request.resource.data) && (isAdmin() || activeOwner(request.resource.data));
      allow update: if isReportsAdmin() && validOwnedRecord(request.resource.data) && recordOwner(request.resource.data) == recordOwner(resource.data) && (isAdmin() || activeOwner(resource.data));
      allow delete: if isAdmin();
    }

    // Payroll and bank identifiers are kept out of the broadly readable users collection.
    match /user_private/{userId} {
      allow read: if isReportsAdmin() && (canReadStaffHistory() || activeStaffId(userId));
      allow create, update: if isReportsAdmin() && (isAdmin() || activeStaffId(userId));
      allow delete: if isAdmin();
    }

    // ── System Commands ───────────────────────────────────────
    match /system_commands/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR();
    }

    // ── Events ────────────────────────────────────────────────
    match /events/{docId} {
      allow read: if canReadStaffHistory() || ownRecord(resource.data);
      allow create: if isAuthenticated() && (
        (request.resource.data.get('type', '') in ['holiday', 'meeting', 'event'] && attendanceManager() && request.resource.data.get('createdById', '') == request.auth.uid) ||
        (!(request.resource.data.get('type', '') in ['holiday', 'meeting', 'event']) && ownRecord(request.resource.data)));
      allow update: if isAuthenticated() && (isAdmin() || activeOwner(resource.data)) && recordOwner(request.resource.data) == recordOwner(resource.data) && (
        (request.resource.data.get('type', '') in ['holiday', 'meeting', 'event'] && attendanceManager()) ||
        (!(request.resource.data.get('type', '') in ['holiday', 'meeting', 'event']) && ownRecord(resource.data)));
      allow delete: if isAdmin() || (ownRecord(resource.data) && !(resource.data.get('type', '') in ['holiday', 'meeting', 'event']));
    }

    // ── Daily Summaries ───────────────────────────────────────
    match /daily_summaries/{docId} {
      allow read: if canReadStaffHistory();
      allow create, update: if isAdmin() && validSharedSummary(request.resource.data);
      allow delete: if isAdmin();
    }

    // ── Daily Summaries Meta ──────────────────────────────────
    match /daily_summaries_meta/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && validSharedSummary(request.resource.data);
      allow delete: if isAdmin();
    }

    // ── Summary Locks ─────────────────────────────────────────
    match /summary_locks/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── App Meta ──────────────────────────────────────────────
    match /app_meta/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Policies ──────────────────────────────────────────────
    match /policies/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Admin Policies ────────────────────────────────────────
    match /admin_policies/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR();
    }

    // ── Annual Plan ───────────────────────────────────────────
    match /annual_plan/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR();
    }

    // ── Budget Heads ──────────────────────────────────────────
    match /budget_heads/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR();
    }

    // ── Task Activity Events ──────────────────────────────────
    match /task_activity_events/{docId} {
      allow read: if canReadStaffHistory() || ownRecord(resource.data);
      allow create: if ownRecord(request.resource.data) && validOwnedRecord(request.resource.data) && request.resource.data.get('actorId', request.auth.uid) == request.auth.uid;
      allow update: if validOwnedRecord(request.resource.data) && ownRecord(resource.data) && recordOwner(request.resource.data) == recordOwner(resource.data);
      allow delete: if isAdmin();
    }

    // ── Classification Patterns ───────────────────────────────
    match /classification_patterns/{docId} {
      allow read: if canReadStaffHistory() || ownRecord(resource.data);
      allow create: if ownRecord(request.resource.data) && validOwnedRecord(request.resource.data);
      allow update: if ownRecord(resource.data) && validOwnedRecord(request.resource.data) && recordOwner(request.resource.data) == recordOwner(resource.data);
      allow delete: if isAdmin();
    }

    // ── Journey Reflections ───────────────────────────────────
    match /journey_reflections/{docId} {
      allow read: if canReadStaffHistory() || ownRecord(resource.data);
      allow create: if ownRecord(request.resource.data) && validOwnedRecord(request.resource.data);
      allow update: if validOwnedRecord(request.resource.data) && (isAdmin() || ownRecord(resource.data)) && recordOwner(request.resource.data) == recordOwner(resource.data);
      allow delete: if isAdmin();
    }

    // ── Birthday People ───────────────────────────────────────
    match /birthday_people/{docId} {
      allow read: if canReadStaffHistory();
      allow write: if isBirthdayAdmin();
    }

    // ── Letter Pad Profiles ───────────────────────────────────
    match /letter_pad_profiles/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }

    // ── System Audit Logs ─────────────────────────────────────
    match /system_audit_logs/{docId} {
      allow read: if isAdmin() || isHR();
      // Employment audit entries are written atomically by the server action.
      allow create: if isAuthenticated() && request.resource.data.get('type', '') != 'staff-employment';
      allow update: if isAdmin() && resource.data.get('type', '') != 'staff-employment' &&
        request.resource.data.get('type', '') != 'staff-employment';
      allow delete: if isAdmin() && resource.data.get('type', '') != 'staff-employment';
    }

    // ── AI Collections (Phase 3) ──────────────────────────────
    match /ai_findings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ai_memory/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ai_evidence/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Metrics (Phase 2) ─────────────────────────────────────
    match /metrics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
