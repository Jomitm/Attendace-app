# Firestore Security Rules — CRWI Attendance App
# Requires Firebase Authentication. All requests must be authenticated.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.isAdmin == true;
    }

    function isHR() {
      return isAuthenticated() && (request.auth.token.role == 'hr' || request.auth.token.role == 'Administrator');
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.isAdmin == true;
    }

    function isStaff() {
      return isAuthenticated() && request.auth.token.role == 'Employee';
    }

    // ── Users ──────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read (needed for staff directory, team views)
      allow read: if isAuthenticated();
      // Users can update their own profile; admins can update anyone
      allow create: if isAdmin();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Attendance ─────────────────────────────────────────────
    match /attendance/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Staff can update their own; HR/admin can update anyone
      allow update: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid ||
        isHR() || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Leaves ─────────────────────────────────────────────────
    match /leaves/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      // Staff can update their own (cancel); HR/admin can approve/reject
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isHR() || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Minutes ────────────────────────────────────────────────
    match /minutes/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isHR();
    }

    // ── Staff Messages ────────────────────────────────────────
    match /staff_messages/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Location Audits ───────────────────────────────────────
    match /location_audits/{docId} {
      allow read: if isAuthenticated();
      // Anyone can create (check-in location logging)
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Work Plans ────────────────────────────────────────────
    match /work_plans/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Day Plan ──────────────────────────────────────────────
    match /day_plan/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Meetings ──────────────────────────────────────────────
    match /meetings/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin() || isHR();
    }

    // ── Salaries ──────────────────────────────────────────────
    match /salaries/{docId} {
      allow read: if isAdmin() || isHR();
      allow write: if isAdmin();
    }

    // ── System Commands ───────────────────────────────────────
    match /system_commands/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR();
    }

    // ── Events ────────────────────────────────────────────────
    match /events/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Daily Summaries ───────────────────────────────────────
    match /daily_summaries/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Daily Summaries Meta ──────────────────────────────────
    match /daily_summaries_meta/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── Summary Locks ─────────────────────────────────────────
    match /summary_locks/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── App Meta ──────────────────────────────────────────────
    match /app_meta/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Policies ──────────────────────────────────────────────
    match /policies/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Admin Policies ────────────────────────────────────────
    match /admin_policies/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR();
    }

    // ── Annual Plan ───────────────────────────────────────────
    match /annual_plan/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR();
    }

    // ── Budget Heads ──────────────────────────────────────────
    match /budget_heads/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isHR();
    }

    // ── Task Activity Events ──────────────────────────────────
    match /task_activity_events/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Classification Patterns ───────────────────────────────
    match /classification_patterns/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Journey Reflections ───────────────────────────────────
    match /journey_reflections/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Birthday People ───────────────────────────────────────
    match /birthday_people/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }

    // ── Letter Pad Profiles ───────────────────────────────────
    match /letter_pad_profiles/{docId} {
      allow read: if isAuthenticated();
      allow write: if isHR() || isAdmin();
    }

    // ── System Audit Logs ─────────────────────────────────────
    match /system_audit_logs/{docId} {
      allow read: if isAdmin() || isHR();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── AI Collections (Phase 3) ──────────────────────────────
    match /ai_findings/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /ai_memory/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /ai_evidence/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ── Metrics (Phase 2) ─────────────────────────────────────
    match /metrics/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
