{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noImplicitAny": false,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["js/**/*.js", "api/**/*.js", "tests/**/*.mjs", "jsconfig-globals.d.ts"],
    "exclude": ["node_modules", "dist"]
}
