OPENROUTER_HTTP_REFERER=http://localhost:3004
OPENROUTER_APP_TITLE=CRWI Attendance App
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_group_chat_id_here

# Telegram webhook forgery protection (recommended).
# Set this to a long random string, then call setWebhook with secret_token=<same value>.
# When set, requests without the matching X-Telegram-Bot-Api-Secret-Token header are rejected.
TELEGRAM_WEBHOOK_SECRET=

# Shared secret for Vercel cron jobs (telegram-scheduler).
# Set CRON_SECRET in your Vercel project env; Vercel then sends it as
# "Authorization: Bearer <CRON_SECRET>" on scheduled invocations.
CRON_SECRET=

# HMAC secret for calendar feed tokens (calendar-token.js / calendar-feed.js).
# REQUIRED — the endpoints refuse to run when this is unset.
CALENDAR_FEED_SECRET=

# xAI (Grok) credentials for the AI assistant endpoint.
GROK_API_KEY=
GROK_MODEL=grok-beta

# Firebase service account JSON (single-line string) for serverless admin SDK access.
FIREBASE_SERVICE_ACCOUNT=
